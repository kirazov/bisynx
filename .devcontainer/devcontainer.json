{
  "name": "bisynx devcontainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.lintTool": "golangci-lint",
        "go.lintFlags": [
          "--fast"
        ]
      }
    }
  }
}